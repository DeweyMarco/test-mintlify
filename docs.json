{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Quotes API",
  "theme": "willow",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "min-light",
        "dark": "min-dark"
      }
    }
  },
  "api": {
    "baseUrl": "http://localhost:3000",
    "playground": {
      "proxy": false
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  }
}
