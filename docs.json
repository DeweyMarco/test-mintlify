{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Quotes API",
  "theme": "willow",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "min-light",
        "dark": "min-dark"
      }
    }
  },
  "api": {
    "baseUrl": "http://localhost:3000",
    "playground": {
      "proxy": false
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Changelog",
          "href": "/changelog",
          "icon": "clock-rotate-left"
        }
      ]
    },
    "groups": [
      {
        "group": "Get Started",
        "pages": ["introduction", "quickstart", "changelog"]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.yaml",
        "pages": [
          "api-reference/get-random-quote",
          "api-reference/list-quotes",
          "api-reference/get-quote-by-id",
          "api-reference/list-categories"
        ]
      }
    ]
  }
}
