{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Quotes API",
  "theme": "willow",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon/favicon.svg",
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "min-light",
        "dark": "min-dark"
      }
    }
  },
  "api": {
    "baseUrl": "http://localhost:3000",
    "playground": {
      "proxy": false
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.yaml",
        "pages": [
          "GET /quotes",
          "GET /quotes/random",
          {
            "group": "Get quote by ID",
            "tag": "Beta",
            "pages": ["GET /quotes/{id}"]
          },
          "GET /categories"
        ]
      }
    ]
  }
}
